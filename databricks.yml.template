# This is a Databricks asset bundle definition for pinterest_databricks_pipeline_simulation.
# The Databricks extension requires databricks.yml configuration file.
# See https://docs.databricks.com/dev-tools/bundles/index.html for documentation.

bundle:
  name: pinterest_databricks_pipeline_simulation

permissions:
  - user_name: <your-email@example.com>
    level: CAN_MANAGE

targets:
  dev:
    mode: development
    default: true
    workspace:
      host: https://<workspace-url>
  

resources:
  jobs:
    simulator:
      name: find_next_job
      schedule:
        quartz_cron_expression: "0 0/5 * * * ?"
        timezone_id: "UTC"
      tasks:
        - task_key: move_batch
          notebook_task:
            notebook_path: ./notebooks/find_next_job.ipynb

    pinterest_pipeline:
      name: pinterest_databricks_pipeline_simulation
      trigger:
        file_arrival:
          url: /Volumes/workspace/default/pinterest_pipeline/inbox/
      tasks:
        - task_key: bronze
          notebook_task:
            notebook_path: ./notebooks/bronze_ingest.ipynb
        - task_key: silver
          depends_on:
            - task_key: bronze
          notebook_task:
            notebook_path: ./notebooks/silver_transform.ipynb
        - task_key: gold
          depends_on:
            - task_key: silver
          notebook_task:
            notebook_path: ./notebooks/gold_metrics.ipynb
        - task_key: views
          depends_on:
            - task_key: gold
          notebook_task:
            notebook_path: ./notebooks/create_sql_views.ipynb